<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 2rem; line-height: 1.5; }
      header { margin-bottom: 1.5rem; }
      .hero { background: #f7f7f7; padding: 1.25rem; border-radius: 8px; }
      .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem; }
      .card { padding: 1rem; border: 1px solid #eee; border-radius: 8px; }
      footer { margin-top: 2rem; color: #666; font-size: .9rem; }
    </style>
  </head>
  <body>
    <header>
      <h1>{{ title }}</h1>
      <p>{{ description }}</p>
    </header>
    <section class="hero">
      <strong>Welcome!</strong> This page was generated by AI Factory.
      <div class="features">
        <div class="card">Fast setup</div>
        <div class="card">Auditable outputs</div>
        <div class="card">Reproducible builds</div>
      </div>
    </section>
    <footer>
      <p>Generated at build time. Customize as needed.</p>
    </footer>
  </body>
  </html>
