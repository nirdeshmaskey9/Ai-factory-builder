# Environment variables for AI Factory Builder (do not commit secrets)

# Server host and port
AI_FACTORY_HOST=127.0.0.1
AI_FACTORY_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
AI_FACTORY_LOG_LEVEL=INFO

# (Reserved for future phases)
# OPENAI_API_KEY=

# Unified Ollama daemon
OLLAMA_HOST=http://127.0.0.1:11434

# Trio model assignments (Local Trio v4)
AI_FACTORY_LOCAL_STRATEGIST_MODEL=phi3:medium
AI_FACTORY_LOCAL_MEMORY_MODEL=mistral
AI_FACTORY_LOCAL_EXECUTION_MODEL=phi3:mini

# Health/interval tuning
AI_FACTORY_LOCAL_TIMEOUT=120
AI_FACTORY_HEALTH_INTERVAL=15
AI_FACTORY_TRIO_INTERVAL=60
